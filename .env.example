# Copy to .env and replace every example value before starting Docker Compose.
MYSQL_ROOT_PASSWORD=replace-with-a-long-root-password
MYSQL_USER=induztek_app
MYSQL_PASSWORD=replace-with-a-long-database-password
MYSQL_PORT=3306

# Use a cryptographically random value of at least 32 bytes.
JWT_SECRET=replace-with-at-least-32-random-bytes-for-hmac
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password
REGISTRATION_REQUIRE_APPROVAL=true

GATEWAY_PORT=8080

# URL con la que la app ve el gateway. Se usa para armar la URL de las fotos.
#  - Emulador:           http://10.0.2.2:8080
#  - Tunel (VS Code):    https://xxxx-8080.brs.devtunnels.ms   (sin barra final)
PUBLIC_BASE_URL=http://10.0.2.2:8080

# URLs de los microservicios (OPCIONAL). Si no las defines, el gateway y los
# servicios usan los nombres de Docker. Descomenta solo para apuntar a otro "VPS"
# (por ejemplo, la URL publica de un tunel).
#IDENTITY_SERVICE_URL=http://identity-service:8081
#ROLES_SERVICE_URL=http://roles-service:8082
#CATALOG_SERVICE_URL=http://catalog-service:8083
#OPERATIONS_SERVICE_URL=http://operations-service:8084
#NOTIFICATIONS_SERVICE_URL=http://notifications-service:8086

# SMTP is required for password-reset email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
